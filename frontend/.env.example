# Rushes frontend — copy to .env.local
#   cp .env.example .env.local
# Both values are server-side only: the browser talks to /api/* on this app,
# which proxies to the backend, so the token never reaches the client.

# Where the FastAPI backend is listening.
BACKEND_URL=http://localhost:8080

# Only needed if the backend sets API_TOKEN.
API_TOKEN=
