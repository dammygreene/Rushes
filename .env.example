# ============================================================================
# Rushes — copy to .env and fill in.  Never commit .env.
#   cp .env.example .env
# The backend loads this file from the repo root (see backend/src/rushes/config.py).
# ============================================================================

# --- app ---------------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8080
# Public origin of the backend. Used to build playable URLs for archive clips
# served out of ./data/clips. In production point this at Cloud Run/GCS.
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated CORS allow-list for the browser/frontend.
ALLOWED_ORIGINS=http://localhost:3000
# Optional shared secret. If set, /api/search requires: Authorization: Bearer <token>
API_TOKEN=

# --- Google / Gemini ---------------------------------------------------------
# AI Studio path (simplest): set GOOGLE_API_KEY, leave USE_VERTEXAI false.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
# Vertex AI path instead: USE_VERTEXAI=true + project/location + ADC login
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Run `python -m rushes.pipeline.doctor` to list model ids your key can serve.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# 768 / 1536 / 3072 are supported by gemini-embedding-001. Must match the
# dimension already stored in ClickHouse — changing it requires re-seeding.
EMBEDDING_DIM=768

# --- ClickHouse Cloud --------------------------------------------------------
# These exact names are also handed to the mcp-clickhouse server process.
CLICKHOUSE_HOST=your-service.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=archive_clips

# --- mcp-clickhouse (MCP server spawned over stdio) --------------------------
# Leave blank to auto-detect ./mcp-server/.venv (created by scripts/setup).
# Override to use uvx instead:  MCP_CLICKHOUSE_COMMAND=uvx
#                              MCP_CLICKHOUSE_ARGS=mcp-clickhouse
MCP_CLICKHOUSE_COMMAND=
MCP_CLICKHOUSE_ARGS=
MCP_STARTUP_TIMEOUT=90
MCP_CALL_TIMEOUT=45

# --- external sources (metadata + outbound links only, never rehosted) -------
# https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=
# any | creativeCommon  — creativeCommon narrows results but is licence-safer
YOUTUBE_VIDEO_LICENSE=any
# https://www.pexels.com/api/
PEXELS_API_KEY=
# Internet Archive needs no key.
ARCHIVE_ORG_BASE=https://archive.org

# --- search tuning -----------------------------------------------------------
SEARCH_TOP_K_ARCHIVE=8
SEARCH_TOP_K_EXTERNAL=6
RESULT_LIMIT=24
# diverse = guarantee every source appears near the top (demo default)
# score   = strict global score order
RANKING_STRATEGY=diverse
# One batched Gemini call writes the "why this matched" lines. Off = keyword
# overlap only (instant, no tokens).
ENABLE_LLM_REASONS=true

# --- frontend (frontend/.env.local) ------------------------------------------
# BACKEND_URL is server-side only, so the token above never reaches the browser.
BACKEND_URL=http://localhost:8080
